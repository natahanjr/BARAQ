# Editor configuration: https://editorconfig.org
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{js,jsx,json,yml,yaml,css,html}]
indent_style = space
indent_size = 2

[*.{md,rst}]
trim_trailing_whitespace = false

[*.{cmd,bat,ps1}]
end_of_line = crlf
