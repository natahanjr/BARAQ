{
  "uid": "sentinel-overview",
  "title": "SentinelSOC - Platform Overview",
  "tags": ["sentinel", "soc"],
  "editable": true,
  "refresh": "15s",
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "description": "Live state of the SentinelSOC backend: security score, event ingestion, alert pipeline, collectors, ML and database health.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Security Score",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prom" },
      "targets": [
        { "expr": "sentinel_security_score", "legendFormat": "score", "refId": "A" }
      ],
      "options": {
        "legend": { "showLegend": true, "displayMode": "list" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 80 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Open Alerts",
      "gridPos": { "h": 8, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prom" },
      "targets": [
        { "expr": "sentinel_open_alerts", "refId": "A" }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Collectors",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prom" },
      "targets": [
        { "expr": "sum(sentinel_collectors_enabled)", "refId": "A" }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "green", "value": 6 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Event ingestion rate (by source)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prom" },
      "targets": [
        {
          "expr": "sum(rate(sentinel_events_total[5m])) by (source)",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "mode": "list", "displayMode": "list", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": { "defaults": { "unit": "events/s" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Alert throughput by severity",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prom" },
      "targets": [
        {
          "expr": "sum(rate(sentinel_alerts_total[5m])) by (severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "mode": "list", "displayMode": "list", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": { "defaults": { "unit": "alerts/s" } }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Alerts by severity (total)",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prom" },
      "targets": [
        {
          "expr": "sum(sentinel_alerts_total) by (severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "auto",
        "showValue": "auto",
        "legend": { "showLegend": false, "displayMode": "list" }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Database Size",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prom" },
      "targets": [
        { "expr": "sentinel_db_size_bytes", "refId": "A" }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 8, "w": 4, "x": 4, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prom" },
      "targets": [
        { "expr": "sentinel_uptime_seconds", "refId": "A" }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "dtdurations" } }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Detection Rules",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prom" },
      "targets": [
        { "expr": "sentinel_rules_total", "refId": "A" }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto" }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "ML streams ready",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prom" },
      "targets": [
        { "expr": "sentinel_ml_streams_ready", "refId": "A" }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "max": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Incidents",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prom" },
      "targets": [
        { "expr": "sentinel_incidents_total", "refId": "A" }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    }
  ]
}